generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  BOOSTER
  BLISTER
  TRIPACK
  BUNDLE
  DISPLAY
  ETB
  COLLECTION_BOX
  TIN
  DECK
  ACCESSORY
  SINGLE_CARD
  OTHER
}

enum ProductLanguage {
  FR
  EN
  JP
  DE
  ES
  IT
  OTHER
}

enum ProductCondition {
  NEW
}

enum SlugEntity {
  PRODUCT
  CATEGORY
  SET
  GAME
}

model Game {
  id             String      @id @default(uuid()) @db.Uuid
  name           String
  slug           String      @unique
  shortName      String?
  description    String?
  intro          String?     @db.Text
  seoTitle       String?
  seoDescription String?
  faq            Json?
  logoUrl        String?
  sortOrder      Int         @default(0)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  sets           TcgSet[]
  products       Product[]
  promotions     Promotion[]
}

model SlugRedirect {
  id         String     @id @default(uuid()) @db.Uuid
  entityType SlugEntity
  fromSlug   String
  entityId   String     @db.Uuid
  createdAt  DateTime   @default(now())

  @@unique([entityType, fromSlug])
}

model Product {
  id               String                          @id @default(uuid()) @db.Uuid
  name             String
  slug             String                          @unique
  description      String?                         @db.Text
  shortDescription String?
  status           ProductStatus                   @default(DRAFT)
  productType      ProductType
  featured         Boolean                         @default(false)
  newArrival       Boolean                         @default(false)
  preorder         Boolean                         @default(false)
  releaseDate      DateTime?                       @db.Date
  publishedAt      DateTime?
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  categoryId       String                          @db.Uuid
  tcgSetId         String?                         @db.Uuid
  gameId           String?                         @db.Uuid
  category         Category                        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tcgSet           TcgSet?                         @relation(fields: [tcgSetId], references: [id], onDelete: Restrict)
  game             Game?                           @relation(fields: [gameId], references: [id], onDelete: Restrict)
  variants         ProductVariant[]
  images           ProductImage[]
  tags             Tag[]
  orderItems       OrderItem[]
  wishlistItems    WishlistItem[]
  pilotageLaunches BusinessPilotageLaunchProduct[]

  @@index([status])
  @@index([productType])
  @@index([categoryId])
  @@index([tcgSetId])
  @@index([gameId])
  @@index([releaseDate])
}

model ProductVariant {
  id                String                @id @default(uuid()) @db.Uuid
  productId         String                @db.Uuid
  product           Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku               String                @unique
  barcode           String?               @unique
  language          ProductLanguage       @default(FR)
  condition         ProductCondition      @default(NEW)
  price             Decimal               @db.Decimal(10, 2)
  compareAtPrice    Decimal?              @db.Decimal(10, 2)
  costPrice         Decimal?              @db.Decimal(10, 2)
  stockQuantity     Int                   @default(0)
  reservedQuantity  Int                   @default(0)
  availableQuantity Int                   @default(dbgenerated())
  orderItems        OrderItem[]
  reservations      StockReservation[]
  stockAlerts       StockAlert[]
  lowStockThreshold Int                   @default(2)
  isActive          Boolean               @default(true)
  isDefault         Boolean               @default(false)
  adjustments       InventoryAdjustment[]
  cartItems         CartItem[]
  weightGrams       Int?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([productId])
}

model Category {
  id             String      @id @default(uuid()) @db.Uuid
  name           String
  slug           String      @unique
  description    String?
  intro          String?     @db.Text
  seoTitle       String?
  seoDescription String?
  faq            Json?
  imageUrl       String?
  parentId       String?     @db.Uuid
  parent         Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]  @relation("CategoryTree")
  sortOrder      Int         @default(0)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  products       Product[]
  promotions     Promotion[]

  @@index([parentId])
}

model TcgSet {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  slug           String    @unique
  code           String?   @unique
  series         String?
  description    String?
  intro          String?   @db.Text
  seoTitle       String?
  seoDescription String?
  faq            Json?
  releaseDate    DateTime? @db.Date
  logoUrl        String?
  symbolUrl      String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  gameId         String?   @db.Uuid
  game           Game?     @relation(fields: [gameId], references: [id], onDelete: Restrict)
  products       Product[]

  @@index([gameId])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
}

model Tag {
  id       String    @id @default(uuid()) @db.Uuid
  name     String
  slug     String    @unique
  products Product[]
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

model Cart {
  id        String            @id @default(uuid()) @db.Uuid
  tokenHash String            @unique @db.Char(64)
  status    CartStatus        @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  expiresAt DateTime
  items     CartItem[]
  checkouts CheckoutSession[]

  @@index([status])
  @@index([expiresAt])
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  variantId String         @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
}

enum CheckoutStatus {
  IN_PROGRESS
  READY_FOR_PAYMENT
  COMPLETED
  EXPIRED
}

enum CheckoutAddressRole {
  SHIPPING
  BILLING
}

enum ShippingMethodType {
  HOME_DELIVERY
  EXPRESS
}

model CheckoutSession {
  id               String            @id @default(uuid()) @db.Uuid
  cartId           String            @db.Uuid
  cart             Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  status           CheckoutStatus    @default(IN_PROGRESS)
  email            String?
  phone            String?
  billingSame      Boolean           @default(true)
  shippingMethodId String?           @db.Uuid
  shippingMethod   ShippingMethod?   @relation(fields: [shippingMethodId], references: [id], onDelete: Restrict)
  shippingAmount   Decimal?          @db.Decimal(10, 2)
  readyFingerprint String?           @db.Char(64)
  /// Promotional code typed by the customer, checked again at each step.
  promotionId      String?           @db.Uuid
  promotion        Promotion?        @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  expiresAt        DateTime
  addresses        CheckoutAddress[]
  order            Order?

  @@index([cartId, status])
  @@index([expiresAt])
  @@index([shippingMethodId])
  @@index([promotionId])
}

model CheckoutAddress {
  id           String              @id @default(uuid()) @db.Uuid
  checkoutId   String              @db.Uuid
  checkout     CheckoutSession     @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  role         CheckoutAddressRole
  firstName    String
  lastName     String
  company      String?
  addressLine1 String
  addressLine2 String?
  postalCode   String
  city         String
  region       String?
  countryCode  String              @db.Char(2)
  phone        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([checkoutId, role])
}

model ShippingCountry {
  code     String           @id @db.Char(2)
  name     String
  isActive Boolean          @default(true)
  methods  ShippingMethod[]
}

model ShippingMethod {
  id               String             @id @default(uuid()) @db.Uuid
  code             String             @unique
  name             String
  description      String?
  type             ShippingMethodType @default(HOME_DELIVERY)
  price            Decimal            @db.Decimal(10, 2)
  freeFromAmount   Decimal?           @db.Decimal(10, 2)
  estimatedMinDays Int?
  estimatedMaxDays Int?
  isActive         Boolean            @default(true)
  isDevelopment    Boolean            @default(false)
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  countries        ShippingCountry[]
  checkouts        CheckoutSession[]

  @@index([isActive, sortOrder])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  PAYMENT_FAILED
  PAYMENT_REVIEW
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

model Order {
  id                     String               @id @default(uuid()) @db.Uuid
  publicId               String               @unique @db.Char(64)
  orderNumber            String               @unique
  status                 OrderStatus          @default(PENDING_PAYMENT)
  email                  String
  phone                  String?
  currency               String               @db.Char(3)
  subtotalAmount         Decimal              @db.Decimal(10, 2)
  /// Shipping actually charged, after a free-shipping code.
  shippingAmount         Decimal              @db.Decimal(10, 2)
  /// Promotional discount on the items (sum of OrderItem.discountAmount).
  discountAmount         Decimal              @default(0) @db.Decimal(10, 2)
  /// Shipping price waived by a free-shipping code.
  shippingDiscountAmount Decimal              @default(0) @db.Decimal(10, 2)
  /// Snapshot of the code used: the promotion may change or disappear later.
  promotionCode          String?
  promotionLabel         String?
  /// subtotal − discount + shipping.
  totalAmount            Decimal              @db.Decimal(10, 2)
  fulfillmentStatus      FulfillmentStatus    @default(UNFULFILLED)
  preparationStartedAt   DateTime?
  readyToShipAt          DateTime?
  shippedAt              DateTime?
  deliveredAt            DateTime?
  shipments              Shipment[]
  emails                 EmailDelivery[]
  internalNote           String?              @db.Text
  shippingMethodCode     String
  shippingMethodName     String
  checkoutSessionId      String               @unique @db.Uuid
  checkoutSession        CheckoutSession      @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  /// Account signed in when the order was placed; kept (null) if the account is deleted.
  customerId             String?              @db.Uuid
  customer               Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  paidAt                 DateTime?
  cancelledAt            DateTime?
  items                  OrderItem[]
  addresses              OrderAddress[]
  payment                Payment?
  reservations           StockReservation[]
  refunds                Refund[]
  promotionRedemption    PromotionRedemption?
  returns                ReturnRequest[]
  invoices               Invoice[]

  @@index([status])
  @@index([fulfillmentStatus, paidAt])
  @@index([shippedAt])
  @@index([customerId])
}

model OrderItem {
  id             String          @id @default(uuid()) @db.Uuid
  orderId        String          @db.Uuid
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId      String?         @db.Uuid
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId      String?         @db.Uuid
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName    String
  productSlug    String
  sku            String
  language       ProductLanguage
  unitPrice      Decimal         @db.Decimal(10, 2)
  unitCost       Decimal?        @db.Decimal(10, 2)
  quantity       Int
  lineTotal      Decimal         @db.Decimal(10, 2)
  discountAmount Decimal         @default(0) @db.Decimal(10, 2)
  imageUrl       String
  createdAt      DateTime        @default(now())

  refundItems RefundItem[]
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderAddress {
  id           String              @id @default(uuid()) @db.Uuid
  orderId      String              @db.Uuid
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  role         CheckoutAddressRole
  firstName    String
  lastName     String
  company      String?
  addressLine1 String
  addressLine2 String?
  postalCode   String
  city         String
  region       String?
  countryCode  String              @db.Char(2)
  phone        String?

  @@unique([orderId, role])
}

model Payment {
  id                      String          @id @default(uuid()) @db.Uuid
  orderId                 String          @unique @db.Uuid
  order                   Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider                PaymentProvider @default(STRIPE)
  providerPaymentIntentId String?         @unique
  status                  PaymentStatus   @default(REQUIRES_PAYMENT_METHOD)
  amount                  Decimal         @db.Decimal(10, 2)
  currency                String          @db.Char(3)
  intentStartedAt         DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  paidAt                  DateTime?
  refunds                 Refund[]
}

model StockReservation {
  id        String            @id @default(uuid()) @db.Uuid
  orderId   String            @db.Uuid
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId String            @db.Uuid
  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([orderId, variantId])
  @@index([variantId])
  @@index([status, expiresAt])
}

model StripeWebhookEvent {
  id            String    @id @default(uuid()) @db.Uuid
  stripeEventId String    @unique
  type          String
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
}

enum AdminRole {
  ADMIN
}

enum InventoryAdjustmentType {
  RESTOCK
  CORRECTION
  DAMAGE
  LOSS
  RETURN
  MANUAL
}

model AdminUser {
  id                  String                @id @default(uuid()) @db.Uuid
  email               String                @unique
  emailVerified       Boolean               @default(false)
  name                String
  image               String?
  role                AdminRole             @default(ADMIN)
  isActive            Boolean               @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  sessions            AdminSession[]
  accounts            AdminAccount[]
  adjustments         InventoryAdjustment[]
  auditLogs           AdminAuditLog[]
  newsletterCampaigns NewsletterCampaign[]
  refunds             Refund[]
  promotions          Promotion[]
  returns             ReturnRequest[]
}

model AdminSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model AdminAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  user                  AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model AdminVerification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model AdminLoginAttempt {
  key         String   @id
  count       Int
  windowStart DateTime
}

// Customer accounts (better-auth, src/lib/account/auth.ts): tables and cookies
// separate from the administration.
model Customer {
  id            String            @id @default(uuid()) @db.Uuid
  email         String            @unique
  emailVerified Boolean           @default(false)
  name          String
  image         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sessions      CustomerSession[]
  accounts      CustomerAccount[]
  address       CustomerAddress?
  orders        Order[]
  wishlistItems WishlistItem[]
  stockAlerts   StockAlert[]
}

model WishlistItem {
  customerId String   @db.Uuid
  productId  String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([customerId, productId])
  @@index([customerId, createdAt])
  @@index([productId])
}

model CustomerSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      Customer @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model CustomerAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  user                  Customer  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model CustomerVerification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Default delivery address, prefilled at checkout.
model CustomerAddress {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @unique @db.Uuid
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  company      String?
  addressLine1 String
  addressLine2 String?
  postalCode   String
  city         String
  region       String?
  countryCode  String   @db.Char(2)
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Fixed windows for sign-in, sign-up and reset requests (key = hashed scope).
model CustomerAuthAttempt {
  key         String   @id
  count       Int
  windowStart DateTime
}

model InventoryAdjustment {
  id               String                  @id @default(uuid()) @db.Uuid
  variantId        String                  @db.Uuid
  variant          ProductVariant          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  adminUserId      String                  @db.Uuid
  adminUser        AdminUser               @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  type             InventoryAdjustmentType
  quantityDelta    Int
  previousQuantity Int
  newQuantity      Int
  reason           String
  createdAt        DateTime                @default(now())

  @@index([variantId, createdAt])
  @@index([adminUserId])
}

model BusinessPilotageSettings {
  id                String                          @id @default("caldera")
  revenueTarget     Decimal                         @default(10000) @db.Decimal(12, 2)
  minimumMarginRate Decimal                         @default(20) @db.Decimal(5, 2)
  maxStockBudget    Decimal                         @default(1000) @db.Decimal(12, 2)
  cashBalance       Decimal                         @default(0) @db.Decimal(12, 2)
  trackingStartDate DateTime?                       @db.Date
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  launchProducts    BusinessPilotageLaunchProduct[]
}

model BusinessPilotageLaunchProduct {
  id         String                   @id @default(uuid()) @db.Uuid
  settingsId String
  settings   BusinessPilotageSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  productId  String                   @db.Uuid
  product    Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime                 @default(now())

  @@unique([settingsId, productId])
  @@index([productId])
}

model AdminAuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  action      String
  entityType  String
  entityId    String    @db.Uuid
  metadata    Json
  createdAt   DateTime  @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([adminUserId])
}

enum FulfillmentStatus {
  UNFULFILLED
  PREPARING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
}

enum ShipmentStatus {
  DRAFT
  SHIPPED
  DELIVERED
}

enum EmailType {
  ORDER_CONFIRMATION
  ORDER_SHIPPED
  ORDER_REFUNDED
  /// Acknowledgment of a return or withdrawal (durable medium).
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @db.Uuid
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  isPrimary      Boolean        @default(true)
  status         ShipmentStatus @default(DRAFT)
  carrierCode    String
  carrierName    String
  hasTracking    Boolean        @default(true)
  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([trackingNumber])
}

model EmailDelivery {
  id                String      @id @default(uuid()) @db.Uuid
  orderId           String      @db.Uuid
  order             Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  type              EmailType
  recipient         String
  provider          String      @default("resend")
  providerMessageId String?
  status            EmailStatus @default(PENDING)
  snapshot          Json
  envelope          Json?
  attemptCount      Int         @default(0)
  firstAttemptAt    DateTime?
  nextAttemptAt     DateTime    @default(now())
  leaseUntil        DateTime?
  leaseToken        String?     @db.Uuid
  retryBlocked      Boolean     @default(false)
  lastError         String?
  sentAt            DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  /// « orderId:TYPE », or « orderId:ORDER_REFUNDED:refundId »: one e-mail per event.
  dedupeKey String @unique

  @@index([orderId, type])
  @@index([status, nextAttemptAt])
  @@index([leaseUntil])
  @@index([type])
}

enum NewsletterStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

enum NewsletterCampaignStatus {
  DRAFT
  QUEUED
  SENDING
  COMPLETED
}

enum NewsletterDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

/// Voluntary newsletter subscriptions. Confirmation tokens are stored hashed;
/// the explicit consent and its version remain auditable.
model NewsletterSubscriber {
  id                    String                       @id @default(uuid()) @db.Uuid
  email                 String                       @unique
  status                NewsletterStatus             @default(PENDING)
  consentAt             DateTime
  consentSource         String                       @default("homepage")
  consentVersion        String
  confirmationTokenHash String?                      @unique @db.Char(64)
  confirmationExpiresAt DateTime?
  confirmedAt           DateTime?
  unsubscribedAt        DateTime?
  lastInterestAt        DateTime
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  deliveries            NewsletterCampaignDelivery[]

  @@index([status, createdAt])
  @@index([confirmationExpiresAt])
}

/// Newsletter copy is kept locally so the admin can prepare and preview a
/// campaign before freezing its audience. Delivery is handled by the same
/// idempotent Resend queue as the transactional e-mails.
model NewsletterCampaign {
  id             String                       @id @default(uuid()) @db.Uuid
  internalName   String
  subject        String
  preheader      String?
  heading        String
  bodyMarkdown   String                       @db.Text
  ctaLabel       String?
  ctaUrl         String?
  status         NewsletterCampaignStatus     @default(DRAFT)
  recipientCount Int                          @default(0)
  createdById    String                       @db.Uuid
  createdBy      AdminUser                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  queuedAt       DateTime?
  completedAt    DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  deliveries     NewsletterCampaignDelivery[]

  @@index([status, createdAt])
  @@index([createdById])
}

model NewsletterCampaignDelivery {
  id                String                   @id @default(uuid()) @db.Uuid
  campaignId        String                   @db.Uuid
  campaign          NewsletterCampaign       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  subscriberId      String                   @db.Uuid
  subscriber        NewsletterSubscriber     @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
  recipient         String
  status            NewsletterDeliveryStatus @default(PENDING)
  provider          String                   @default("resend")
  providerMessageId String?
  envelope          Json?
  attemptCount      Int                      @default(0)
  firstAttemptAt    DateTime?
  nextAttemptAt     DateTime                 @default(now())
  leaseUntil        DateTime?
  leaseToken        String?                  @db.Uuid
  retryBlocked      Boolean                  @default(false)
  lastError         String?
  sentAt            DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([campaignId, subscriberId])
  @@index([status, nextAttemptAt])
  @@index([leaseUntil])
  @@index([subscriberId])
}

enum StockAlertStatus {
  /// Waiting for the e-mail confirmation of a visitor (24 hours).
  PENDING
  /// Confirmed: one e-mail will be sent when the variant can be bought again.
  ACTIVE
  /// Leased by the maintenance job while the e-mail is being sent.
  SENDING
  NOTIFIED
  /// Delivery attempts exhausted.
  FAILED
}

/// Back-in-stock alert for one variant (language) and one e-mail address
/// (src/lib/stock-alerts). Personal data kept only as long as useful: pending
/// 24 hours, notified 30 days, any alert 12 months at most.
model StockAlert {
  id                    String           @id @default(uuid()) @db.Uuid
  email                 String
  variantId             String           @db.Uuid
  variant               ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// Signed-in customer who asked; deleted with the account.
  customerId            String?          @db.Uuid
  customer              Customer?        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status                StockAlertStatus @default(PENDING)
  confirmationTokenHash String?          @unique @db.Char(64)
  confirmationExpiresAt DateTime?
  confirmedAt           DateTime?
  attemptCount          Int              @default(0)
  nextAttemptAt         DateTime         @default(now())
  leaseUntil            DateTime?
  lastError             String?
  providerMessageId     String?
  notifiedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([email, variantId])
  @@index([variantId, status])
  @@index([status, nextAttemptAt])
  @@index([customerId])
  @@index([confirmationExpiresAt])
}

enum RefundStatus {
  /// Recorded, sent or about to be sent to Stripe, not settled yet.
  PENDING
  /// Stripe needs the customer (rare for cards).
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
}

enum RefundReason {
  CUSTOMER_REQUEST
  RETURN_RECEIVED
  DAMAGED
  MISSING_ITEM
  OUT_OF_STOCK
  DUPLICATE
  FRAUD
  OTHER
}

/// Refund of a paid order through Stripe (src/lib/refunds). Several partial
/// refunds may follow each other; together they never exceed the payment.
model Refund {
  id               String         @id @default(uuid()) @db.Uuid
  orderId          String         @db.Uuid
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId        String         @db.Uuid
  payment          Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount           Decimal        @db.Decimal(10, 2)
  /// Part of `amount` refunding the shipping costs.
  shippingAmount   Decimal        @default(0) @db.Decimal(10, 2)
  currency         String         @db.Char(3)
  reason           RefundReason
  /// Internal note, never shown to the customer.
  note             String?        @db.Text
  status           RefundStatus   @default(PENDING)
  providerRefundId String?        @unique
  failureReason    String?
  /// Refunded items go back on sale once the refund succeeds.
  restock          Boolean        @default(false)
  restockedAt      DateTime?
  /// Side effects (restock, e-mail, audit) applied exactly once.
  settledAt        DateTime?
  succeededAt      DateTime?
  /// Null when the refund was made directly in the Stripe Dashboard.
  createdById      String?        @db.Uuid
  createdBy        AdminUser?     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  /// One key per form display: a double submission creates one refund.
  idempotencyKey   String         @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  items            RefundItem[]
  returnRequest    ReturnRequest?
  creditNote       Invoice?       @relation("CreditNoteRefund")

  @@index([orderId, createdAt])
  @@index([status, updatedAt])
  @@index([paymentId])
  @@index([createdById])
}

model RefundItem {
  id          String    @id @default(uuid()) @db.Uuid
  refundId    String    @db.Uuid
  refund      Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItemId String    @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity    Int
  /// Share of the refund allocated to this line (euros).
  amount      Decimal   @db.Decimal(10, 2)

  @@unique([refundId, orderItemId])
  @@index([orderItemId])
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum PromotionRedemptionStatus {
  /// Order created, payment not settled yet: the use already counts.
  RESERVED
  CONSUMED
  /// Order cancelled or expired before payment.
  RELEASED
}

/// Promotional code typed at checkout (src/lib/promotions). Orders keep a
/// snapshot, so a promotion can be edited or disabled at any time.
model Promotion {
  id              String                @id @default(uuid()) @db.Uuid
  /// Upper case letters, digits and dashes: what the customer types.
  code            String                @unique
  /// Shown to the customer next to the discount.
  label           String
  type            PromotionType
  /// PERCENTAGE only: 1 to 90.
  percentOff      Int?
  /// FIXED_AMOUNT only: euros off the eligible items.
  amountOff       Decimal?              @db.Decimal(10, 2)
  /// Eligible items subtotal required.
  minimumSubtotal Decimal?              @db.Decimal(10, 2)
  startsAt        DateTime?
  endsAt          DateTime?
  maxRedemptions  Int?
  /// Per e-mail address.
  maxPerCustomer  Int?
  isActive        Boolean               @default(true)
  /// Only items of this game; null: every game.
  gameId          String?               @db.Uuid
  game            Game?                 @relation(fields: [gameId], references: [id], onDelete: Restrict)
  /// Only items of this category or its sub-categories.
  categoryId      String?               @db.Uuid
  category        Category?             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdById     String?               @db.Uuid
  createdBy       AdminUser?            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  redemptions     PromotionRedemption[]
  checkouts       CheckoutSession[]

  @@index([isActive, endsAt])
  @@index([gameId])
  @@index([categoryId])
  @@index([createdById])
}

/// One use of a code by one order; RESERVED and CONSUMED count against the limits.
model PromotionRedemption {
  id             String                    @id @default(uuid()) @db.Uuid
  promotionId    String                    @db.Uuid
  promotion      Promotion                 @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  orderId        String                    @unique @db.Uuid
  order          Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Lower case: the per-customer limit follows the e-mail address.
  email          String
  status         PromotionRedemptionStatus @default(RESERVED)
  /// Items and shipping discount granted.
  discountAmount Decimal                   @db.Decimal(10, 2)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([promotionId, status])
  @@index([promotionId, email])
}

enum ReturnStatus {
  /// Declared by the customer (or created by the shop), not answered yet.
  REQUESTED
  /// Accepted: return instructions sent.
  APPROVED
  /// Parcel received and checked.
  RECEIVED
  /// Refund confirmed by Stripe.
  REFUNDED
  REJECTED
  /// Withdrawn by the customer or closed by the shop.
  CANCELED
}

enum ReturnReason {
  /// Legal right of withdrawal (14 days after delivery).
  WITHDRAWAL
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  OTHER
}

enum ReturnSource {
  CUSTOMER
  ADMIN
}

/// Customer return or withdrawal (src/lib/returns), settled by a refund.
model ReturnRequest {
  id              String       @id @default(uuid()) @db.Uuid
  /// « RET-2026-XXXXXXXX », given to the customer.
  number          String       @unique
  orderId         String       @db.Uuid
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status          ReturnStatus @default(REQUESTED)
  reason          ReturnReason
  source          ReturnSource
  /// Written by the customer; shown in the administration only.
  customerMessage String?      @db.Text
  /// Instructions or answer sent to the customer by e-mail.
  resolution      String?      @db.Text
  /// Never shown to the customer.
  internalNote    String?      @db.Text
  createdById     String?      @db.Uuid
  createdBy       AdminUser?   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  approvedAt      DateTime?
  receivedAt      DateTime?
  refundedAt      DateTime?
  closedAt        DateTime?
  /// The refund settling this return (a failed one can be replaced).
  refundId        String?      @unique @db.Uuid
  refund          Refund?      @relation(fields: [refundId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           ReturnItem[]

  @@index([orderId])
  @@index([status, createdAt])
  @@index([createdById])
}

model ReturnItem {
  id            String        @id @default(uuid()) @db.Uuid
  returnId      String        @db.Uuid
  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId   String        @db.Uuid
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity      Int

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
}

enum VatRegime {
  /// Franchise en base (art. 293 B du CGI): no VAT charged nor shown.
  FRANCHISE
  /// VAT charged; prices stay VAT inclusive.
  STANDARD
}

/// Identity printed on invoices (singleton « caldera »), edited in the
/// administration. Invoices keep a copy: editing it never changes them.
model InvoiceSettings {
  id             String    @id @default("caldera")
  legalName      String    @default("CALDERA")
  tradeName      String    @default("Les Terres de Caldera")
  legalForm      String    @default("SASU")
  /// « 1 000 € »: mandatory on the invoices of a company.
  shareCapital   String?
  street         String    @default("74 rue Pierre Valdo")
  postalCode     String    @default("69005")
  city           String    @default("Lyon")
  country        String    @default("France")
  siren          String?
  siret          String?
  /// City of the trade register, e.g. « Lyon ».
  rcsCity        String?
  vatNumber      String?
  email          String    @default("contact@lesterresdecaldera.fr")
  vatRegime      VatRegime @default(FRANCHISE)
  /// Rate applied without Stripe Tax once VAT is charged (percent).
  defaultVatRate Decimal   @default(20) @db.Decimal(5, 2)
  /// Free text at the bottom of every invoice.
  footer         String?   @db.Text
  updatedAt      DateTime  @updatedAt
}

enum InvoiceKind {
  INVOICE
  CREDIT_NOTE
}

/// Gap-free numbering per kind and calendar year (« INVOICE:2026 »).
model InvoiceSequence {
  id   String @id
  next Int    @default(1)
}

/// Invoice issued when an order is paid, credit note when a refund succeeds
/// (src/lib/invoices). Never edited nor deleted: `snapshot` holds everything
/// printed, the PDF is rendered from it.
model Invoice {
  id          String      @id @default(uuid()) @db.Uuid
  kind        InvoiceKind
  /// « F-2026-000001 » or « AV-2026-000001 ».
  number      String      @unique
  /// « INVOICE:orderId » or « CREDIT_NOTE:refundId »: one document per event.
  dedupeKey   String      @unique
  orderId     String      @db.Uuid
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refundId    String?     @unique @db.Uuid
  refund      Refund?     @relation("CreditNoteRefund", fields: [refundId], references: [id], onDelete: Restrict)
  /// The invoice a credit note corrects.
  invoiceId   String?     @db.Uuid
  invoice     Invoice?    @relation("CreditNoteInvoice", fields: [invoiceId], references: [id], onDelete: Restrict)
  creditNotes Invoice[]   @relation("CreditNoteInvoice")
  issuedAt    DateTime    @default(now())
  currency    String      @db.Char(3)
  /// VAT included; a credit note's amount is positive (the sum credited).
  totalAmount Decimal     @db.Decimal(10, 2)
  taxAmount   Decimal     @default(0) @db.Decimal(10, 2)
  snapshot    Json
  createdAt   DateTime    @default(now())

  @@index([orderId])
  @@index([kind, issuedAt])
  @@index([invoiceId])
}
