# Identifiants de développement local uniquement ; cohérents avec docker-compose.yml.
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caldera?schema=public"

# Origine locale pour les canonical / Open Graph.
# Production : SITE_URL="https://lesterresdecaldera.fr"
SITE_URL="http://localhost:3000"

# Stripe : clés de test du même sandbox en local. Les clés live (rk_live_/pk_live_)
# ne sont acceptées que par un build de production, jamais dans ce fichier.
# Une clé restreinte rk_ avec droits PaymentIntents est préférable.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Origine de retour Stripe ; SITE_URL sert de repli.
# Production : APP_URL="https://lesterresdecaldera.fr"
APP_URL="http://localhost:3000"

# Admin : générer avec openssl rand -hex 32. Jamais de valeur par défaut en production.
BETTER_AUTH_SECRET=""
# Leaked-password check (Have I Been Pwned, k-anonymity) on sign-up, change
# and reset. Keep it on in production; "off" only for offline tests.
PASSWORD_BREACH_CHECK=""
# Images téléversées. Vercel : connecter un store Blob privé au projet, Vercel
# ajoute BLOB_STORE_ID (auth OIDC). Hors Vercel : BLOB_READ_WRITE_TOKEN du store,
# ou UPLOAD_DIR vers un volume persistant. Sans rien : .data/uploads en développement.
# UPLOAD_DIR="/var/lib/caldera/uploads"

# Emails transactionnels : activation explicite, expéditeur vérifié chez Resend.
EMAILS_ENABLED=false
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="Les Terres de Caldera <commandes@exemple.fr>"
EMAIL_REPLY_TO=""
# Destinataire interne du formulaire /contact (non exposé côté client).
CONTACT_EMAIL_TO=""
# Obligatoire en développement / sur localhost pour éviter les envois clients.
EMAIL_TEST_RECIPIENT=""
NEWSLETTER_DAILY_LIMIT=80
# Secret distinct pour les liens personnels de consultation (openssl rand -hex 32).
ORDER_ACCESS_SECRET=""

# Planificateur : Bearer exigé par /api/cron/maintenance (openssl rand -hex 32, 16 caractères minimum).
# Vercel Cron l’envoie automatiquement ; un planificateur externe doit envoyer le même en-tête.
# Vide : la route répond 503 et n’exécute rien.
CRON_SECRET=""

# Supervision Sentry : DSN public du projet (intégré au build). Vide : Sentry désactivé.
NEXT_PUBLIC_SENTRY_DSN=""
# Facultatif, au build uniquement : envoi des source maps à Sentry (jamais servies publiquement).
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
