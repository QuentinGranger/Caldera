# Identifiants de développement local uniquement ; cohérents avec docker-compose.yml.
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caldera?schema=public"

# Origine locale pour les canonical / Open Graph.
# Production : SITE_URL="https://lesterresdecaldera.fr"
SITE_URL="http://localhost:3000"

# Stripe : exclusivement des clés de test du même sandbox.
# Une clé restreinte rk_test_ avec droits PaymentIntents est préférable.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Origine de retour Stripe ; SITE_URL sert de repli.
# Production : APP_URL="https://lesterresdecaldera.fr"
APP_URL="http://localhost:3000"

# Admin : générer avec openssl rand -hex 32. Jamais de valeur par défaut en production.
BETTER_AUTH_SECRET=""
# Production uniquement : chemin absolu vers un volume persistant monté.
# UPLOAD_DIR="/var/lib/caldera/uploads"

# Emails transactionnels : activation explicite, expéditeur vérifié chez Resend.
EMAILS_ENABLED=false
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="Les Terres de Caldera <commandes@exemple.fr>"
EMAIL_REPLY_TO=""
# Destinataire interne du formulaire /contact (non exposé côté client).
CONTACT_EMAIL_TO=""
# Obligatoire en développement / sur localhost pour éviter les envois clients.
EMAIL_TEST_RECIPIENT=""
# Secret distinct pour les liens personnels de consultation (openssl rand -hex 32).
ORDER_ACCESS_SECRET=""

# Mondial Relay — variables exclusivement serveur, fournies par votre contrat.
# L'intégration reste désactivée tant que toutes les valeurs obligatoires manquent.
MONDIAL_RELAY_ENABLED=false
MONDIAL_RELAY_BRAND_CODE=""
MONDIAL_RELAY_PRIVATE_KEY=""
MONDIAL_RELAY_API_URL="https://api.mondialrelay.com/web_services.asmx"
# Codes contractuels communiqués par Mondial Relay (aucune valeur implicite).
MONDIAL_RELAY_COLLECTION_MODE=""
MONDIAL_RELAY_DELIVERY_MODE=""
# Coordonnées expéditeur déclarées dans le contrat.
MONDIAL_RELAY_SENDER_NAME=""
MONDIAL_RELAY_SENDER_ADDRESS1=""
MONDIAL_RELAY_SENDER_ADDRESS2=""
MONDIAL_RELAY_SENDER_POSTAL_CODE=""
MONDIAL_RELAY_SENDER_CITY=""
MONDIAL_RELAY_SENDER_COUNTRY="FR"
MONDIAL_RELAY_SENDER_PHONE=""
MONDIAL_RELAY_SENDER_EMAIL=""
